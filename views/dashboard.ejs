<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DesiFusion Dashboard</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    .avatar-option {
      cursor: pointer;
      transition: all 0.3s ease;
    }
    .avatar-option:hover {
      transform: scale(1.05);
    }
    .selected-avatar {
      border: 3px solid #4c51bf;
    }
  </style>
</head>
<body class="min-h-screen py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto bg-white rounded-xl shadow-2xl overflow-hidden">
    <header class="bg-gradient-to-r from-purple-600 to-indigo-600 text-white py-6 px-6">
      <div class="flex justify-between items-center">
        <a href="/" class="text-3xl font-bold tracking-tight">DesiFusion</a>
        <nav>
          <ul class="flex gap-6">
            <li><a href="/" class="hover:text-gray-200 transition duration-150 ease-in-out">Home</a></li>
            <li><a href="/recipes" class="hover:text-gray-200 transition duration-150 ease-in-out">Recipes</a></li>
            <li><a href="/about" class="hover:text-gray-200 transition duration-150 ease-in-out">About</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main class="p-6 sm:p-10">
      <div class="mb-12 text-center">
        <img src="<%= user.avatar %>" alt="<%= user.name %>" class="w-32 h-32 rounded-full mx-auto mb-4 border-4 border-purple-500 shadow-lg object-cover">
        <h2 class="text-3xl font-bold text-gray-800 mb-2"><%= user.name %></h2>
        <p class="text-gray-600 max-w-md mx-auto"><%= user.bio %></p>
      </div>

      <div class="mb-12">
        <h3 class="text-2xl font-semibold mb-6 text-gray-800 border-b pb-2">Update Avatar</h3>
        <form action="/update-avatar" method="POST" class="space-y-6">
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
            <% avatarOptions.forEach((avatar, index) => { %>
              <div class="avatar-option <%= user.avatar === avatar ? 'selected-avatar' : '' %>">
                <img src="<%= avatar %>" alt="Avatar option <%= index + 1 %>" class="w-24 h-24 rounded-full object-cover">
                <input type="radio" name="avatarOption" value="<%= avatar %>" class="hidden" <%= user.avatar === avatar ? 'checked' : '' %>>
              </div>
            <% }) %>
          </div>
          <button type="submit" class="w-full bg-gradient-to-r from-purple-600 to-indigo-600 text-white px-6 py-3 rounded-md hover:from-purple-700 hover:to-indigo-700 transition duration-150 ease-in-out">
            Update Avatar
          </button>
        </form>
      </div>

      <div class="mb-12">
        <h3 class="text-2xl font-semibold mb-6 text-gray-800 border-b pb-2">Profile Information</h3>
        <form action="/update-profile" method="POST" class="space-y-6">
          <div>
            <label for="name" class="block mb-2 text-sm font-medium text-gray-700">Name</label>
            <input type="text" id="name" name="name" value="<%= user.name %>" class="w-full p-3 border border-gray-300 rounded-md focus:ring-2 focus:ring-purple-500 focus:border-transparent">
          </div>
          <div>
            <label for="email" class="block mb-2 text-sm font-medium text-gray-700">Email</label>
            <input type="email" id="email" name="email" value="<%= user.email %>" class="w-full p-3 border border-gray-300 rounded-md focus:ring-2 focus:ring-purple-500 focus:border-transparent">
          </div>
          <div>
            <label for="bio" class="block mb-2 text-sm font-medium text-gray-700">Bio</label>
            <textarea id="bio" name="bio" rows="4" class="w-full p-3 border border-gray-300 rounded-md focus:ring-2 focus:ring-purple-500 focus:border-transparent"><%= user.bio %></textarea>
          </div>
          <button type="submit" class="w-full bg-gradient-to-r from-purple-600 to-indigo-600 text-white px-6 py-3 rounded-md hover:from-purple-700 hover:to-indigo-700 transition duration-150 ease-in-out">
            Update Profile
          </button>
        </form>
      </div>

      <div>
        <h3 class="text-2xl font-semibold mb-6 text-gray-800 border-b pb-2">Change Password</h3>
        <form action="/change-password" method="POST" class="space-y-6">
          <div>
            <label for="currentPassword" class="block mb-2 text-sm font-medium text-gray-700">Current Password</label>
            <input type="password" id="currentPassword" name="currentPassword" class="w-full p-3 border border-gray-300 rounded-md focus:ring-2 focus:ring-purple-500 focus:border-transparent">
          </div>
          <div>
            <label for="newPassword" class="block mb-2 text-sm font-medium text-gray-700">New Password</label>
            <input type="password" id="newPassword" name="newPassword" class="w-full p-3 border border-gray-300 rounded-md focus:ring-2 focus:ring-purple-500 focus:border-transparent">
          </div>
          <div>
            <label for="confirmPassword" class="block mb-2 text-sm font-medium text-gray-700">Confirm New Password</label>
            <input type="password" id="confirmPassword" name="confirmPassword" class="w-full p-3 border border-gray-300 rounded-md focus:ring-2 focus:ring-purple-500 focus:border-transparent">
          </div>
          <button type="submit" class="w-full bg-gradient-to-r from-purple-600 to-indigo-600 text-white px-6 py-3 rounded-md hover:from-purple-700 hover:to-indigo-700 transition duration-150 ease-in-out">
            Change Password
          </button>
        </form>
      </div>
    </main>
  </div>
  <script>
    document.querySelectorAll('.avatar-option').forEach(option => {
      option.addEventListener('click', function() {
        document.querySelectorAll('.avatar-option').forEach(el => el.classList.remove('selected-avatar'));
        this.classList.add('selected-avatar');
        this.querySelector('input[type="radio"]').checked = true;
      });
    });
  </script>
</body>
</html>

